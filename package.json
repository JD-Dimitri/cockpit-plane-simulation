{
  "name": "a350-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulateur pédagogique de type A350 — application Windows autonome (outil non certifié).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @a350/desktop dev",
    "build": "pnpm --filter @a350/desktop build",
    "desktop:dev": "pnpm --filter @a350/desktop tauri dev",
    "desktop:build": "pnpm --filter @a350/desktop tauri build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "e2e": "node tests/e2e/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
